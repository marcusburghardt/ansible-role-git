#!/bin/sh
# Managed by ansible-role-git. Do not edit this file directly.
set -eu

message_file=${1:-}
if [ -z "$message_file" ]; then
  echo "commit-msg: missing commit message file" >&2
  exit 1
fi

helper={{ git_scripts_dir }}/commit_lint.py
if [ ! -f "$helper" ]; then
  echo "commit-msg: $helper not found; run add_supporting_scripts first" >&2
  exit 1
fi

exec python3 "$helper" --file "$message_file" \
  --max-subject {{ git_hooks_max_subject_length }} \
  --max-body {{ git_hooks_max_body_length }}{% if git_hooks_require_signed_off_by %} \
  --require-signed-off-by{% else %} \
  --no-require-signed-off-by{% endif %}{% if git_hooks_require_assisted_by %} \
  --require-assisted-by{% else %} \
  --no-require-assisted-by{% endif %}
